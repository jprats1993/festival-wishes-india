---
interface Props {
  text: string;
  imageUrl?: string;
  pageUrl: string;
  label?: string;
}

const { text, imageUrl, pageUrl, label = 'Share' } = Astro.props;
const shareText = encodeURIComponent(`${text}\n\n${pageUrl}`);
const whatsappUrl = `https://wa.me/?text=${shareText}`;
---

<div class="share-bar flex flex-wrap items-center gap-2 mt-4" data-share-bar data-text={text} data-image={imageUrl} data-url={pageUrl}>
  <button type="button" class="copy-btn px-4 py-2 bg-rose-700 text-white rounded-lg text-sm hover:bg-rose-800 transition" data-action="copy">
    Copy
  </button>
  {imageUrl && (
    <a href={imageUrl} download class="download-btn px-4 py-2 bg-stone-800 text-white rounded-lg text-sm hover:bg-stone-900 transition inline-block" data-action="download">
      Download Card
    </a>
  )}
  <button type="button" class="share-native-btn px-4 py-2 bg-green-600 text-white rounded-lg text-sm hover:bg-green-700 transition" data-action="share-native">
    Share
  </button>
  <a href={whatsappUrl} target="_blank" rel="noopener" class="whatsapp-fallback-btn px-4 py-2 bg-green-500 text-white rounded-lg text-sm hover:bg-green-600 transition inline-block" data-action="whatsapp">
    WhatsApp
  </a>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll('[data-share-bar]').forEach((bar) => {
      const text = bar.getAttribute('data-text') || '';
      const image = bar.getAttribute('data-image');
      const url = bar.getAttribute('data-url') || window.location.href;

      const copyBtn = bar.querySelector('[data-action="copy"]');
      const shareBtn = bar.querySelector('[data-action="share-native"]');

      const track = (name: string, fallback = false) => {
        // fire-and-forget analytics; Worker endpoint may be absent
        try {
          fetch('/api/event', {
            method: 'POST',
            body: JSON.stringify({ event: name, url, fallback }),
            keepalive: true,
          }).catch(() => {});
        } catch {}
      };

      copyBtn?.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(text);
          copyBtn.textContent = 'Copied!';
          setTimeout(() => (copyBtn.textContent = 'Copy'), 2000);
          track('copy_wish');
        } catch {
          copyBtn.textContent = 'Use share instead';
        }
      });

      shareBtn?.addEventListener('click', async () => {
        const shareData: ShareData = { title: 'Festival Wishes India', text, url };
        let files: File[] | undefined;

        if (image && navigator.canShare && navigator.canShare({ files: [] })) {
          try {
            const resp = await fetch(image);
            const blob = await resp.blob();
            const ext = image.split('.').pop() || 'webp';
            files = [new File([blob], `festival-wish.${ext}`, { type: blob.type })];
          } catch {}
        }

        try {
          if (navigator.share) {
            await navigator.share(files ? { ...shareData, files } : shareData);
            track('share_attempt', false);
          } else {
            throw new Error('navigator.share unavailable');
          }
        } catch {
          track('share_attempt', true);
          // fallback: open WhatsApp text link
          const wa = `https://wa.me/?text=${encodeURIComponent(`${text}\n\n${url}`)}`;
          window.open(wa, '_blank');
        }
      });
    });
  });
</script>

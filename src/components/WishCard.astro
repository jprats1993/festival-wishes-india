---
import ShareBar from './ShareBar.astro';
import type { Locale } from '../lib/i18n';

interface Props {
  id: string;
  text: string;
  locale: Locale;
  pageUrl: string;
  number?: number;
}

const { id, text, locale, pageUrl, number } = Astro.props;
---

<article class="wish-card bg-white rounded-xl shadow-sm border border-stone-200 p-5 flex flex-col gap-3" id={id}>
  <div class="flex items-start justify-between gap-2">
    {number !== undefined && (
      <span class="wish-number text-xs font-bold text-rose-600 bg-rose-50 rounded-full px-2 py-0.5">#{number}</span>
    )}
    <blockquote class="text-lg leading-relaxed font-medium text-stone-800 flex-1" lang={locale === 'hinglish' ? 'hi-Latn' : locale}>
      {text}
    </blockquote>
  </div>
  <ShareBar text={text} pageUrl={pageUrl} />
</article>

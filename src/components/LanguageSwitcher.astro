---
import { localeLabels, locales, type Locale } from '../lib/i18n';

interface Props {
  current: Locale;
  alternateUrls: Partial<Record<Locale, string>>;
}

const { current, alternateUrls } = Astro.props;
---

<nav aria-label="Language" class="language-switcher">
  <div class="inline-flex items-center gap-1 rounded-full border border-stone-300 bg-white p-1 text-sm shadow-sm">
    {locales.map((loc) => {
      const url = alternateUrls[loc];
      const isCurrent = loc === current;
      const label = localeLabels[loc];
      return isCurrent ? (
        <span
          class="px-3 py-1 rounded-full bg-rose-700 text-white font-semibold"
          aria-current="true"
        >
          {label}
        </span>
      ) : url ? (
        <a
          href={url}
          hreflang={loc === 'hinglish' ? 'hi-Latn' : loc}
          class="px-3 py-1 rounded-full text-stone-700 hover:bg-rose-50 hover:text-rose-700 transition font-medium"
        >
          {label}
        </a>
      ) : (
        <span class="px-3 py-1 rounded-full text-stone-300">{label}</span>
      );
    })}
  </div>
</nav>

---
import { localeLabels, locales, type Locale } from '../lib/i18n';

interface Props {
  current: Locale;
  alternateUrls: Partial<Record<Locale, string>>;
}

const { current, alternateUrls } = Astro.props;
---

<nav aria-label="Language">
  <ul class="flex items-center gap-2 text-sm">
    {locales.map((loc) => {
      const url = alternateUrls[loc];
      const isCurrent = loc === current;
      return (
        <li>
          {isCurrent ? (
            <span class="px-3 py-1 rounded-full bg-rose-100 text-rose-800 font-medium" aria-current="true">
              {localeLabels[loc]}
            </span>
          ) : url ? (
            <a
              href={url}
              hreflang={loc === 'hinglish' ? 'hi-Latn' : loc}
              class="px-3 py-1 rounded-full border border-stone-300 text-stone-700 hover:border-rose-400 hover:text-rose-700 transition"
            >
              {localeLabels[loc]}
            </a>
          ) : (
            <span class="px-3 py-1 rounded-full text-stone-400">{localeLabels[loc]}</span>
          )}
        </li>
      );
    })}
  </ul>
</nav>

---
import { localeBcp47, locales, localeLabels, type Locale, isLocale } from '../lib/i18n';
import LanguageSwitcher from '../components/LanguageSwitcher.astro';
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  locale: Locale;
  alternateUrls?: Partial<Record<Locale, string>>;
  image?: string;
  noindex?: boolean;
}

const { title, description, locale, alternateUrls = {}, image = '/og-default.png', noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).toString();
const ogImage = new URL(image, Astro.site).toString();
const langAttr = localeBcp47[locale];
---

<!doctype html>
<html lang={langAttr}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    
    {/* hreflang */}
    {locales.map((loc) => {
      const url = alternateUrls[loc];
      if (!url) return null;
      return <link rel="alternate" hreflang={localeBcp47[loc]} href={new URL(url, Astro.site).toString()} />;
    })}
    {alternateUrls['en'] && <link rel="alternate" hreflang="x-default" href={new URL(alternateUrls['en'], Astro.site).toString()} />}
    
    {/* OG */}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content={langAttr} />
    
    {/* Twitter */}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    
    <ClientRouter />
  </head>
  <body class="min-h-screen bg-stone-50 text-stone-900 antialiased">
    {/* Shared icon sprite for ShareBar — defined once per page and referenced via <use> instead of
        re-embedding full SVG path data in every wish card. The WhatsApp glyph alone is ~1.4KB of
        path data; with 50-60+ wish cards per festival page, inlining it per-card was blowing up
        page HTML size (~200KB of the ~243KB page was duplicate icon markup) and made every
        View-Transitions navigation between tabs/pages swap a much heavier DOM than necessary. */}
    <svg aria-hidden="true" style="position:absolute;width:0;height:0;overflow:hidden" xmlns="http://www.w3.org/2000/svg">
      <symbol id="icon-copy" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></symbol>
      <symbol id="icon-download" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></symbol>
      <symbol id="icon-share" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><line x1="8.59" y1="13.51" x2="15.42" y2="17.49"/><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"/></symbol>
      <symbol id="icon-whatsapp" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></symbol>
    </svg>
    <a href="#main" class="sr-only focus:not-sr-only">Skip to content</a>
    <header class="border-b border-stone-200 bg-white">
      <div class="mx-auto max-w-5xl px-4 py-4 flex items-center justify-between">
        <a href={`/${locale}/`} class="text-xl font-bold text-rose-700 hover:text-rose-800">
          Festival Wishes India
        </a>
        <LanguageSwitcher current={locale} alternateUrls={alternateUrls} />
      </div>
    </header>
    <main id="main" class="mx-auto max-w-5xl px-4 py-8">
      <slot />
    </main>
    <footer class="border-t border-stone-200 bg-white mt-auto">
      <div class="mx-auto max-w-5xl px-4 py-6 text-sm text-stone-600">
        <div class="flex flex-wrap gap-4 justify-center">
          <a href={`/${locale}/about/`} class="hover:text-rose-700">{locale === 'hi' ? 'हमारे बारे में' : 'About'}</a>
          <a href={`/${locale}/contact/`} class="hover:text-rose-700">{locale === 'hi' ? 'संपर्क करें' : 'Contact'}</a>
          <a href={`/${locale}/privacy/`} class="hover:text-rose-700">{locale === 'hi' ? 'गोपनीयता नीति' : 'Privacy'}</a>
          <a href={`/${locale}/disclaimer/`} class="hover:text-rose-700">{locale === 'hi' ? 'अस्वीकरण' : 'Disclaimer'}</a>
        </div>
        <p class="text-center mt-4">© {new Date().getFullYear()} Festival Wishes India. AI-assisted editorial content. Wishes are original — see our <a href={`/${locale}/about/`} class="hover:text-rose-700">editorial policy</a>.</p>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --color-rose-700: #be123c;
    --color-rose-800: #9f1239;
  }
</style>

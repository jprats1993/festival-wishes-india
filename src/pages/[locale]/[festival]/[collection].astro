---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import WishCard from '../../../components/WishCard.astro';
import AdSlot from '../../../components/AdSlot.astro';
import { collections, NOINDEX_THRESHOLD } from '../../../lib/collections';
import { locales, localeLabels, isLocale, festivalName } from '../../../lib/i18n';
import { relationTabs } from '../../../lib/relations';
import { getCollection } from 'astro:content';
import type { GetStaticPaths } from 'astro';

export const getStaticPaths = (async () => {
  const paths: { params: { locale: string; festival: string; collection: string } }[] = [];
  const festivals = await getCollection('festival');
  for (const locale of locales) {
    for (const festival of festivals) {
      for (const collection of collections.getCollectionSlugs()) {
        paths.push({ params: { locale, festival: festival.data.slug, collection } });
      }
    }
  }
  return paths;
}) satisfies GetStaticPaths;

const { locale, festival: festivalSlug, collection } = Astro.params;
if (!isLocale(locale)) {
  return Astro.redirect('/en/');
}

const festivals = await getCollection('festival');
const festival = festivals.find((f) => f.data.slug === festivalSlug);
if (!festival) {
  return new Response(null, { status: 404 });
}

const allWishes = await getCollection('wish');
const festivalWishes = allWishes
  .filter((w) => w.data.festival === festivalSlug && w.data.reviewStatus === 'approved')
  .sort((a, b) => a.data.id.localeCompare(b.data.id));
const wishNumbers = new Map(festivalWishes.map((w, i) => [w.data.id, i + 1]));

const relations = collections.getRelationsForCollection(collection) || [];
const tone = collections.getToneForCollection(collection);
const format = collections.getFormatForCollection(collection);
let filtered = festivalWishes;
if (relations.length > 0) {
  filtered = filtered.filter((w) => w.data.relations.some((r) => relations.includes(r)));
}
if (tone) {
  filtered = filtered.filter((w) => w.data.tones.includes(tone as (typeof w.data.tones)[number]));
}
if (format) {
  filtered = filtered.filter((w) => w.data.formats.includes(format as (typeof w.data.formats)[number]));
}

const pageUrl = new URL(`/${locale}/${festivalSlug}/${collection}/`, Astro.site).toString();

const titleMap: Record<string, Record<typeof locale, string>> = {
  'short-wishes': {
    en: `Short ${festivalName(festival, locale)} wishes`,
    hi: `छोटी ${festivalName(festival, locale)} शुभकामनाएँ`,
    hinglish: `Short ${festivalName(festival, locale)} wishes`,
  },
  'brother-wishes': {
    en: `${festivalName(festival, locale)} wishes for brother`,
    hi: `${festivalName(festival, locale)} भाई के लिए शुभकामनाएँ`,
    hinglish: `${festivalName(festival, locale)} bhai ke liye wishes`,
  },
  'sister-wishes': {
    en: `${festivalName(festival, locale)} wishes for sister`,
    hi: `${festivalName(festival, locale)} बहन के लिए शुभकामनाएँ`,
    hinglish: `${festivalName(festival, locale)} behen ke liye wishes`,
  },
  'bhaiya-bhabhi-wishes': {
    en: `${festivalName(festival, locale)} wishes for bhaiya-bhabhi`,
    hi: `${festivalName(festival, locale)} भैया-भाभी के लिए शुभकामनाएँ`,
    hinglish: `${festivalName(festival, locale)} bhaiya-bhabhi ke liye wishes`,
  },
  'whatsapp-messages': {
    en: `${festivalName(festival, locale)} WhatsApp messages`,
    hi: `${festivalName(festival, locale)} व्हाट्सएप संदेश`,
    hinglish: `${festivalName(festival, locale)} WhatsApp messages`,
  },
  'family-wishes': {
    en: `${festivalName(festival, locale)} wishes for family`,
    hi: `${festivalName(festival, locale)} परिवार के लिए शुभकामनाएँ`,
    hinglish: `${festivalName(festival, locale)} family ke liye wishes`,
  },
  'friend-wishes': {
    en: `${festivalName(festival, locale)} wishes for friend`,
    hi: `${festivalName(festival, locale)} दोस्त के लिए शुभकामनाएँ`,
    hinglish: `${festivalName(festival, locale)} friend ke liye wishes`,
  },
  'parent-wishes': {
    en: `${festivalName(festival, locale)} wishes for parents`,
    hi: `${festivalName(festival, locale)} माता-पिता के लिए शुभकामनाएँ`,
    hinglish: `${festivalName(festival, locale)} parents ke liye wishes`,
  },
  'spouse-wishes': {
    en: `${festivalName(festival, locale)} wishes for spouse`,
    hi: `${festivalName(festival, locale)} जीवनसाथी के लिए शुभकामनाएँ`,
    hinglish: `${festivalName(festival, locale)} spouse ke liye wishes`,
  },
};

const title = titleMap[collection]?.[locale] || `${festivalName(festival, locale)} wishes`;
const description =
  locale === 'hi'
    ? `${title} हिन्दी, अंग्रेज़ी और हिंग्लिश में। कॉपी करें, डाउनलोड करें या व्हाट्सएप पर साझा करें।`
    : locale === 'hinglish'
      ? `${title} Hindi, English aur Hinglish mein. Copy, download ya WhatsApp par share karein.`
      : `${title} in Hindi, English and Hinglish. Copy, download or share on WhatsApp.`;

const emptyMessage =
  locale === 'hi'
    ? 'जल्द ही और शुभकामनाएँ आ रही हैं।'
    : locale === 'hinglish'
      ? 'Jald hi aur wishes aa rahi hain.'
      : 'More wishes coming soon.';

const alternateUrls = Object.fromEntries(
  locales.map((loc) => [loc, `/${loc}/${festivalSlug}/${collection}/`])
) as Record<typeof locale, string>;

// noindex if collection is too thin
const noindex = filtered.length < NOINDEX_THRESHOLD;
---

<BaseLayout
  title={title}
  description={description}
  locale={locale}
  alternateUrls={alternateUrls}
  noindex={noindex}
>
  <nav aria-label="Breadcrumb" class="text-sm text-stone-500 mb-4">
    <a href={`/${locale}/`} class="hover:text-rose-700">{localeLabels[locale]}</a>
    <span class="mx-2">/</span>
    <a href={`/${locale}/${festivalSlug}/`} class="hover:text-rose-700">{festivalName(festival, locale)}</a>
    <span class="mx-2">/</span>
    <span class="text-stone-800">{title}</span>
  </nav>

  <div class="text-center py-6">
    <h1 class="text-2xl md:text-3xl font-bold mb-2">{title}</h1>
    <p class="text-stone-600">{description}</p>
  </div>

  <div class="flex flex-wrap items-center gap-2 mb-6" role="tablist" aria-label="Wish categories">
    <a
      href={`/${locale}/${festivalSlug}/`}
      class="px-4 py-2 rounded-full border border-stone-300 text-stone-700 hover:border-rose-400 hover:text-rose-700 font-medium text-sm"
    >
      {locale === 'hi' ? 'सभी' : 'All'}
    </a>
    {relationTabs.map((t) => (
      t.slug === collection ? (
        <span
          role="tab"
          aria-selected="true"
          class="px-4 py-2 rounded-full bg-rose-700 text-white font-medium text-sm"
        >
          {t.label[locale]}
        </span>
      ) : (
        <a
          href={`/${locale}/${festivalSlug}/${t.slug}/`}
          class="px-4 py-2 rounded-full border border-stone-300 text-stone-700 hover:border-rose-400 hover:text-rose-700 font-medium text-sm"
        >
          {t.label[locale]}
        </a>
      )
    ))}
  </div>

  <AdSlot slotName="collection-top" locale={locale} />

  {filtered.length === 0 ? (
    <p class="text-stone-600 text-center py-8">{emptyMessage}</p>
  ) : (
    <div class="grid gap-6 md:grid-cols-2">
      {filtered.map((w) => (
        <WishCard
          id={w.data.id}
          text={w.data.languages[locale]}
          locale={locale}
          pageUrl={pageUrl}
          imageUrl={w.data.imageAssets?.square}
          alt={w.data.altText?.[locale]}
          number={wishNumbers.get(w.data.id)}
        />
      ))}
    </div>
  )}

  <AdSlot slotName="collection-bottom" locale={locale} />
</BaseLayout>

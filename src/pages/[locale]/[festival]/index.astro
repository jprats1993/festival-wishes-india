---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import WishCard from '../../../components/WishCard.astro';
import AdSlot from '../../../components/AdSlot.astro';
import { locales, localeLabels, isLocale } from '../../../lib/i18n';
import { cards } from '../../../lib/cards';
import { getCollection } from 'astro:content';
import type { GetStaticPaths } from 'astro';

export const getStaticPaths = (async () => {
  const paths: { params: { locale: string; festival: string } }[] = [];
  const festivals = await getCollection('festival');
  for (const locale of locales) {
    for (const festival of festivals) {
      paths.push({ params: { locale, festival: festival.data.slug } });
    }
  }
  return paths;
}) satisfies GetStaticPaths;

const { locale, festival: festivalSlug } = Astro.params;
if (!isLocale(locale)) {
  return Astro.redirect('/en/');
}

const festivals = await getCollection('festival');
const festival = festivals.find((f) => f.data.slug === festivalSlug);
if (!festival) {
  return new Response(null, { status: 404 });
}

const allWishes = await getCollection('wish');
const wishes = allWishes.filter(
  (w) => w.data.festival === festivalSlug && w.data.reviewStatus === 'approved'
);

const relationCollections = ['brother', 'sister', 'family', 'friend', 'spouse', 'parent'] as const;
const collections = relationCollections
  .map((rel) => ({
    slug: `${rel}-wishes`,
    title: {
      en: `${festival.data.displayName} wishes for ${rel}`,
      hi: `${festival.data.displayName} ${rel === 'brother' ? 'भाई' : rel === 'sister' ? 'बहन' : rel === 'parent' ? 'माता-पिता' : rel === 'friend' ? 'दोस्त' : rel === 'spouse' ? 'जीवनसाथी' : rel} के लिए शुभकामनाएँ`,
      hinglish: `${festival.data.displayName} ${rel} ke liye wishes`,
    }[locale],
    wishes: wishes.filter((w) => w.data.relations.includes(rel as any)).slice(0, 8),
  }))
  .filter((c) => c.wishes.length >= 3);

const copy = {
  en: {
    subtitle: `Find ${festival.data.displayName} wishes in Hindi, English and Hinglish — short messages, cards and WhatsApp status.`,
    collectionsTitle: 'Curated collections',
    popularTitle: 'Popular wishes',
  },
  hi: {
    subtitle: `${festival.data.displayName} की शुभकामनाएँ हिंदी, अंग्रेज़ी और हिंग्लिश में — छोटे संदेश, कार्ड और व्हाट्सएप स्टेटस।`,
    collectionsTitle: 'चयनित संग्रह',
    popularTitle: 'लोकप्रिय शुभकामनाएँ',
  },
  hinglish: {
    subtitle: `${festival.data.displayName} ki wishes Hindi, English aur Hinglish mein — chhote messages, cards aur WhatsApp status.`,
    collectionsTitle: 'Featured collections',
    popularTitle: 'Popular wishes',
  },
}[locale];

const alternateUrls = Object.fromEntries(
  locales.map((loc) => [loc, `/${loc}/${festivalSlug}/`])
) as Record<typeof locale, string>;

// Cards for this festival + locale
const festivalCards = cards.filter((c) => c.lang === locale);

const cardsTitle = {
  en: 'Shareable cards',
  hi: 'साझा करने योग्य कार्ड',
  hinglish: 'Shareable cards',
}[locale];
---

<BaseLayout
  title={`${festival.data.displayName} Wishes in ${localeLabels[locale]} — Festival Wishes India`}
  description={copy.subtitle}
  locale={locale}
  alternateUrls={alternateUrls}
>
  <div class="text-center py-8">
    <h1 class="text-3xl md:text-4xl font-bold mb-3">{festival.data.displayName}</h1>
    <p class="text-stone-600 max-w-2xl mx-auto">{copy.subtitle}</p>
  </div>

  <AdSlot slotName="hub-top" />

  {festivalCards.length > 0 && (
    <>
      <h2 class="text-2xl font-semibold mb-4">{cardsTitle}</h2>
      <section class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3 mb-10">
        {festivalCards.map((card) => (
          <figure class="bg-white rounded-xl border border-stone-200 overflow-hidden shadow-sm">
            <img
              src={card.src}
              alt={card.alt}
              width={1024}
              height={1024}
              loading="lazy"
              decoding="async"
              class="w-full h-auto"
            />
            <figcaption class="p-3 flex items-center justify-between gap-2">
              <a href={card.src} download class="text-sm font-medium text-rose-700 hover:text-rose-800">Download</a>
            </figcaption>
          </figure>
        ))}
      </section>
    </>
  )}

  <h2 class="text-2xl font-semibold mb-4">{copy.collectionsTitle}</h2>
  <section class="grid gap-6 md:grid-cols-2">
    {collections.map((c) => (
      <a
        href={`/${locale}/${festivalSlug}/${c.slug}/`}
        class="block p-5 bg-white rounded-xl border border-stone-200 hover:border-rose-300 hover:shadow-sm transition"
      >
        <h3 class="text-lg font-semibold text-rose-700">{c.title}</h3>
        <p class="text-sm text-stone-500 mt-1">{c.wishes.length} wishes</p>
      </a>
    ))}
  </section>

  <h2 class="text-2xl font-semibold mt-10 mb-4">{copy.popularTitle}</h2>
  <div class="grid gap-6 md:grid-cols-2">
    {wishes.slice(0, 6).map((w) => (
      <WishCard
        id={w.data.id}
        text={w.data.languages[locale]}
        locale={locale}
        pageUrl={new URL(`/${locale}/${festivalSlug}/`, Astro.site).toString()}
      />
    ))}
  </div>

  <AdSlot slotName="hub-bottom" />
</BaseLayout>

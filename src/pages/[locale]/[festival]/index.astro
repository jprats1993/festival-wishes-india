---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import WishCard from '../../../components/WishCard.astro';
import AdSlot from '../../../components/AdSlot.astro';
import { locales, localeLabels, isLocale } from '../../../lib/i18n';
import { cards } from '../../../lib/cards';
import { popularWishIds } from '../../../lib/popular';
import { getCollection } from 'astro:content';
import type { GetStaticPaths } from 'astro';

export const getStaticPaths = (async () => {
  const paths: { params: { locale: string; festival: string } }[] = [];
  const festivals = await getCollection('festival');
  for (const locale of locales) {
    for (const festival of festivals) {
      paths.push({ params: { locale, festival: festival.data.slug } });
    }
  }
  return paths;
}) satisfies GetStaticPaths;

const { locale, festival: festivalSlug } = Astro.params;
if (!isLocale(locale)) {
  return Astro.redirect('/en/');
}

const festivals = await getCollection('festival');
const festival = festivals.find((f) => f.data.slug === festivalSlug);
if (!festival) {
  return new Response(null, { status: 404 });
}

const allWishes = await getCollection('wish');
const wishes = allWishes
  .filter((w) => w.data.festival === festivalSlug && w.data.reviewStatus === 'approved')
  .sort((a, b) => a.data.id.localeCompare(b.data.id));

const popularWishes = wishes.filter((w) => popularWishIds.includes(w.data.id));

const relationTabs = [
  { slug: 'brother-wishes', label: { en: 'Brother', hi: 'भाई', hinglish: 'Bhai' } },
  { slug: 'sister-wishes', label: { en: 'Sister', hi: 'बहन', hinglish: 'Behen' } },
  { slug: 'bhaiya-bhabhi-wishes', label: { en: 'Bhaiya-Bhabhi', hi: 'भैया-भाभी', hinglish: 'Bhaiya-Bhabhi' } },
  { slug: 'family-wishes', label: { en: 'Family', hi: 'परिवार', hinglish: 'Family' } },
  { slug: 'friend-wishes', label: { en: 'Friend', hi: 'दोस्त', hinglish: 'Dost' } },
  { slug: 'parent-wishes', label: { en: 'Parents', hi: 'माता-पिता', hinglish: 'Parents' } },
];

const festivalCards = cards.filter((c) => c.lang === locale);

const copy = {
  en: {
    subtitle: `Find ${festival.data.displayName} wishes in Hindi, English and Hinglish — short messages, cards and WhatsApp status.`,
    cardsTitle: 'Shareable cards',
    allTab: 'All wishes',
    popularTab: 'Popular wishes',
  },
  hi: {
    subtitle: `${festival.data.displayName} की शुभकामनाएँ हिन्दी, अंग्रेज़ी और हिंग्लिश में — छोटे संदेश, कार्ड और व्हाट्सएप स्टेटस।`,
    cardsTitle: 'साझा करने योग्य कार्ड',
    allTab: 'सभी शुभकामनाएँ',
    popularTab: 'लोकप्रिय शुभकामनाएँ',
  },
  hinglish: {
    subtitle: `${festival.data.displayName} ki wishes Hindi, English aur Hinglish mein — chhote messages, cards aur WhatsApp status.`,
    cardsTitle: 'Shareable cards',
    allTab: 'All wishes',
    popularTab: 'Popular wishes',
  },
}[locale];

const alternateUrls = Object.fromEntries(
  locales.map((loc) => [loc, `/${loc}/${festivalSlug}/`])
) as Record<typeof locale, string>;

const pageUrl = new URL(`/${locale}/${festivalSlug}/`, Astro.site).toString();
---

<BaseLayout
  title={`${festival.data.displayName} Wishes in ${localeLabels[locale]} — Festival Wishes India`}
  description={copy.subtitle}
  locale={locale}
  alternateUrls={alternateUrls}
>
  <div class="text-center py-8">
    <h1 class="text-3xl md:text-4xl font-bold mb-3">{festival.data.displayName}</h1>
    <p class="text-stone-600 max-w-2xl mx-auto">{copy.subtitle}</p>
  </div>

  <AdSlot slotName="hub-top" />

  {festivalCards.length > 0 && (
    <>
      <h2 class="text-2xl font-semibold mb-4">{copy.cardsTitle}</h2>
      <section class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3 mb-10">
        {festivalCards.map((card) => (
          <figure class="bg-white rounded-xl border border-stone-200 overflow-hidden shadow-sm">
            <img
              src={card.src}
              alt={card.alt}
              width={1024}
              height={1024}
              loading="lazy"
              decoding="async"
              class="w-full h-auto"
            />
            <figcaption class="p-3 flex items-center justify-between gap-2">
              <a href={card.src} download class="text-sm font-medium text-rose-700 hover:text-rose-800">Download</a>
            </figcaption>
          </figure>
        ))}
      </section>
    </>
  )}

  <!-- Tabs -->
  <div class="flex flex-wrap items-center gap-2 mb-6" role="tablist" aria-label="Wish categories">
    <button type="button" data-tab="all" class="tab-btn active px-4 py-2 rounded-full bg-rose-700 text-white font-medium text-sm">
      {copy.allTab} ({wishes.length})
    </button>
    <button type="button" data-tab="popular" class="tab-btn px-4 py-2 rounded-full border border-stone-300 text-stone-700 hover:border-rose-400 font-medium text-sm">
      {copy.popularTab} ({popularWishes.length})
    </button>
    {relationTabs.map((t) => (
      <a
        href={`/${locale}/${festivalSlug}/${t.slug}/`}
        class="px-4 py-2 rounded-full border border-stone-300 text-stone-700 hover:border-rose-400 hover:text-rose-700 font-medium text-sm"
      >
        {t.label[locale]}
      </a>
    ))}
  </div>

  <!-- All wishes -->
  <section data-panel="all" class="grid gap-6 md:grid-cols-2">
    {wishes.map((w, i) => (
      <WishCard
        id={w.data.id}
        text={w.data.languages[locale]}
        locale={locale}
        pageUrl={pageUrl}
        number={i + 1}
      />
    ))}
  </section>

  <!-- Popular wishes -->
  <section data-panel="popular" class="grid gap-6 md:grid-cols-2" hidden>
    {popularWishes.map((w, i) => (
      <WishCard
        id={w.data.id}
        text={w.data.languages[locale]}
        locale={locale}
        pageUrl={pageUrl}
        number={i + 1}
      />
    ))}
  </section>

  <AdSlot slotName="hub-bottom" />
</BaseLayout>

<script>
  const tabs = document.querySelectorAll('.tab-btn');
  const panels = document.querySelectorAll('[data-panel]');
  tabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      const target = tab.getAttribute('data-tab');
      tabs.forEach((t) => t.classList.remove('active', 'bg-rose-700', 'text-white'));
      tab.classList.add('active', 'bg-rose-700', 'text-white');
      panels.forEach((p) => {
        p.hidden = p.getAttribute('data-panel') !== target;
      });
    });
  });
</script>

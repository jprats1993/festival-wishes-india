---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { locales, isLocale } from '../../lib/i18n';
import type { GetStaticPaths } from 'astro';

export const getStaticPaths = (() => locales.map((locale) => ({ params: { locale } }))) satisfies GetStaticPaths;

const { locale } = Astro.params;
if (!isLocale(locale)) return Astro.redirect('/en/privacy/');

const alternateUrls = Object.fromEntries(locales.map((loc) => [loc, `/${loc}/privacy/`])) as Record<typeof locale, string>;

const title = locale === 'hi' ? 'गोपनीयता नीति' : locale === 'hinglish' ? 'Privacy Policy' : 'Privacy Policy';
---

<BaseLayout title={title} description="Privacy policy for Festival Wishes India" locale={locale} alternateUrls={alternateUrls}>
  <article class="prose prose-stone max-w-3xl mx-auto py-8">
    <h1 class="text-3xl font-bold mb-6">{title}</h1>
    <p class="mb-4"><strong>Festival Wishes India</strong> is committed to protecting your privacy.</p>
    <h2 class="text-xl font-semibold mt-6 mb-2">Analytics</h2>
    <p class="mb-4">We use privacy-focused analytics (Cloudflare Web Analytics) that do not use cookies or track you personally. No personal data is collected or stored.</p>
    <h2 class="text-xl font-semibold mt-6 mb-2">Ads</h2>
    <p class="mb-4">If Google AdSense is enabled in the future, it will serve ads based on page context and may use cookies in accordance with Google’s policies. We will update this policy before enabling ads.</p>
    <h2 class="text-xl font-semibold mt-6 mb-2">Affiliate links</h2>
    <p class="mb-4">Some gift-guide pages may contain affiliate links. These are clearly disclosed on the page. We earn a small commission if you purchase through them, at no extra cost to you.</p>
    <h2 class="text-xl font-semibold mt-6 mb-2">Contact</h2>
    <p>Questions? Email <a href="mailto:jprats1993@gmail.com" class="text-rose-700 hover:underline">jprats1993@gmail.com</a>.</p>
  </article>
</BaseLayout>

---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { locales, localeLabels, localeBcp47, isLocale } from '../../lib/i18n';
import { getCollection } from 'astro:content';
import type { GetStaticPaths } from 'astro';

export const getStaticPaths = (() => {
  return locales.map((locale) => ({ params: { locale } }));
}) satisfies GetStaticPaths;

const { locale } = Astro.params;
if (!isLocale(locale)) {
  return Astro.redirect('/en/');
}

const festivals = await getCollection('festivals');
const wishes = await getCollection('wish');
const approvedWishes = wishes.filter((w) => w.data.reviewStatus === 'approved');

const copy = {
  en: {
    title: 'Festival Wishes India',
    heading: 'Choose a festival',
    sub: `${approvedWishes.length} wishes across ${festivals.length} festivals in Hindi, English and Hinglish.`,
  },
  hi: {
    title: 'फ़ेस्टिवल विशेस इंडिया',
    heading: 'अपना त्योहार चुनें',
    sub: `हिन्दी, अंग्रेज़ी और हिंग्लिश में ${approvedWishes.length} शुभकामनाएं।`,
  },
  hinglish: {
    title: 'Festival Wishes India',
    heading: 'Apna festival chunein',
    sub: `Hindi, English aur Hinglish mein ${approvedWishes.length} wishes.`,
  },
}[locale];

const alternateUrls = Object.fromEntries(
  locales.map((loc) => [loc, loc === 'en' ? '/en/' : `/${loc}/`])
) as Record<typeof locale, string>;
---

<BaseLayout
  title={copy.title}
  description={copy.sub}
  locale={locale}
  alternateUrls={alternateUrls}
>
  <div class="text-center py-10">
    <h1 class="text-3xl md:text-4xl font-bold mb-3">{copy.heading}</h1>
    <p class="text-stone-600">{copy.sub}</p>
  </div>
  <section class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
    {festivals.map((f) => (
      <a
        href={`/${locale}/${f.data.slug}/`}
        class="block p-6 bg-white rounded-xl border border-stone-200 hover:border-rose-300 hover:shadow-sm transition"
      >
        <h2 class="text-xl font-semibold text-rose-700 mb-2">{f.data.displayName}</h2>
        <p class="text-sm text-stone-500">
          {new Date(f.data.date).toLocaleDateString(locale === 'hi' ? 'hi-IN' : locale === 'hinglish' ? 'en-IN' : 'en-IN', {
            year: 'numeric',
            month: 'long',
            day: 'numeric',
          })}
        </p>
      </a>
    ))}
  </section>
</BaseLayout>

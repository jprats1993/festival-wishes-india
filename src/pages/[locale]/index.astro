---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { locales, localeLabels, isLocale, festivalName } from '../../lib/i18n';
import { getCollection } from 'astro:content';
import type { GetStaticPaths } from 'astro';

export const getStaticPaths = (() => {
  return locales.map((locale) => ({ params: { locale } }));
}) satisfies GetStaticPaths;

const { locale } = Astro.params;
if (!isLocale(locale)) {
  return Astro.redirect('/en/');
}

const festivals = await getCollection('festival');
const wishes = await getCollection('wish');
const approvedWishes = wishes.filter((w) => w.data.reviewStatus === 'approved');

const copy = {
  en: {
    title: 'Festival Wishes India',
    heading: 'Choose a festival',
    sub: `${approvedWishes.length} wishes across ${festivals.length} festivals. Switch language on any festival page.`,
    langNote: 'English · Hindi · Hinglish',
  },
  hi: {
    title: 'फ़ेस्टिवल विशेस इंडिया',
    heading: 'अपना त्योहार चुनें',
    sub: `${festivals.length} त्योहारों पर ${approvedWishes.length} शुभकामनाएँ। किसी भी त्योहार के पेज से भाषा बदलें।`,
    langNote: 'अंग्रेज़ी · हिन्दी · हिंग्लिश',
  },
  hinglish: {
    title: 'Festival Wishes India',
    heading: 'Apna festival chunein',
    sub: `${festivals.length} festivals par ${approvedWishes.length} wishes. Kisi bhi festival page se language badlein.`,
    langNote: 'English · Hindi · Hinglish',
  },
}[locale];

const alternateUrls = Object.fromEntries(
  locales.map((loc) => [loc, loc === 'en' ? '/en/' : `/${loc}/`])
) as Record<typeof locale, string>;
---

<BaseLayout
  title={copy.title}
  description={copy.sub}
  locale={locale}
  alternateUrls={alternateUrls}
>
  <div class="text-center py-10">
    <h1 class="text-3xl md:text-4xl font-bold mb-3">{copy.heading}</h1>
    <p class="text-stone-600">{copy.sub}</p>
    <p class="text-sm text-stone-500 mt-2">{copy.langNote}</p>
  </div>

  <section class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
    {festivals.map((f, i) => (
      <a
        href={`/${locale}/${f.data.slug}/`}
        class="block bg-white rounded-xl border border-stone-200 overflow-hidden hover:border-rose-300 hover:shadow-sm transition text-center"
      >
        <img
          src={`/images/${f.data.slug}/banner.webp`}
          alt=""
          width={800}
          height={500}
          loading={i === 0 ? 'eager' : 'lazy'}
          fetchpriority={i === 0 ? 'high' : 'auto'}
          decoding="async"
          class="w-full h-auto aspect-[8/5] object-cover"
        />
        <div class="p-6">
          <h2 class="text-xl font-semibold text-rose-700 mb-2">{festivalName(f, locale)}</h2>
          <p class="text-sm text-stone-500">
            {new Date(f.data.date).toLocaleDateString(locale === 'hi' ? 'hi-IN' : 'en-IN', {
              year: 'numeric',
              month: 'long',
              day: 'numeric',
            })}
          </p>
        </div>
      </a>
    ))}
  </section>
</BaseLayout>

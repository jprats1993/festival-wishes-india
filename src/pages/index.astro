---
import { locales } from '../lib/i18n';
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'Festival Wishes India — Rakhi, Diwali & More in Hindi, English & Hinglish';
const description = 'Find sincere festival wishes and ready-to-share cards for Raksha Bandhan, Diwali, Holi and more. Hindi, English and Hinglish messages for WhatsApp, status and cards.';
---

<BaseLayout title={title} description={description} locale="en">
  <div class="text-center py-12 md:py-16">
    <h1 class="text-3xl md:text-5xl font-bold text-stone-900 mb-4">
      Festival Wishes India
    </h1>
    <p class="text-lg md:text-xl text-stone-600 max-w-2xl mx-auto mb-8">
      Find a sincere festival message or ready-to-share card in the language and tone you need — in under a minute.
    </p>
    <a
      href="/en/rakhi/"
      class="inline-block px-8 py-3 bg-rose-700 text-white rounded-full text-lg font-medium hover:bg-rose-800 transition"
    >
      ✨ Raksha Bandhan Wishes
    </a>
  </div>

  <section class="grid gap-6 md:grid-cols-3 py-8">
    {locales.map((loc) => (
      <a
        href={loc === 'en' ? '/en/' : `/${loc}/`}
        class="block p-6 bg-white rounded-xl border border-stone-200 hover:border-rose-300 hover:shadow-sm transition"
      >
        <h2 class="text-xl font-semibold text-rose-700 mb-2">
          {loc === 'hi' ? 'हिन्दी' : loc === 'hinglish' ? 'Hinglish' : 'English'}
        </h2>
        <p class="text-stone-600">
          {loc === 'hi'
            ? 'रक्षाबंधन, दिवाली और अन्य त्योहारों की शुभकामनाएँ।'
            : loc === 'hinglish'
            ? 'Rakhi, Diwali aur baki festivals ke liye messages aur cards.'
            : 'Wishes, messages and cards for Rakhi, Diwali and other festivals.'}
        </p>
      </a>
    ))}
  </section>
</BaseLayout>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const title = 'Festival Wishes India — Rakhi, Diwali & More in Hindi, English & Hinglish';
const description = 'Find sincere festival wishes and ready-to-share cards for Raksha Bandhan, Diwali, Holi and more. Hindi, English and Hinglish messages for WhatsApp, status and cards.';

const festivals = await getCollection('festival');
---

<BaseLayout title={title} description={description} locale="en">
  <div class="text-center py-12 md:py-16">
    <h1 class="text-3xl md:text-5xl font-bold text-stone-900 mb-4">
      Festival Wishes India
    </h1>
    <p class="text-lg md:text-xl text-stone-600 max-w-2xl mx-auto mb-8">
      Find a sincere festival message or ready-to-share card in Hindi, English or Hinglish.
    </p>
  </div>

  <section class="grid gap-6 md:grid-cols-2 lg:grid-cols-3 py-8">
    {festivals.map((f) => (
      <a
        href={`/en/${f.data.slug}/`}
        class="block p-6 bg-white rounded-xl border border-stone-200 hover:border-rose-300 hover:shadow-sm transition text-center"
      >
        <h2 class="text-xl font-semibold text-rose-700 mb-2">{f.data.displayName}</h2>
        <p class="text-sm text-stone-500">
          {new Date(f.data.date).toLocaleDateString('en-IN', {
            year: 'numeric',
            month: 'long',
            day: 'numeric',
          })}
        </p>
        <p class="text-sm text-stone-600 mt-3">English wishes · Hindi shubhkamnayein · Hinglish messages</p>
      </a>
    ))}
  </section>

  <section class="py-8 text-center">
    <p class="text-stone-600">
      Use the language switcher on any festival page to switch between English, हिन्दी and Hinglish.
    </p>
  </section>
</BaseLayout>
